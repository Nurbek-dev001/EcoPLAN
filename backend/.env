APP_NAME="EcoPlan Hub"
APP_VERSION="1.0.0"
DEBUG=True

# Database - PostgreSQL from Docker
DATABASE_URL="postgresql://ecoplan_user:ecoplan_pass@localhost:5433/ecoplan_db"

# JWT
JWT_SECRET_KEY="your-super-secret-key-change-in-production"
JWT_ALGORITHM="HS256"
JWT_EXPIRATION_HOURS=24
JWT_REFRESH_EXPIRATION_DAYS=7

# CORS
CORS_ORIGINS='["http://localhost:3000","http://localhost:5173","http://localhost","http://localhost:8082"]'

# PassFlow Integration
PASSFLOW_API_URL="http://passflow-api/api"
PASSFLOW_API_KEY="api-key"
PASSFLOW_SYNC_HOURS=24

# Server
HOST="0.0.0.0"
PORT=8000

# Redis + Celery
REDIS_URL="redis://localhost:6379/0"

# ClickHouse
CLICKHOUSE_HOST="localhost"
CLICKHOUSE_PORT=8123
CLICKHOUSE_USER="default"
CLICKHOUSE_PASSWORD=""

# Kafka
KAFKA_BOOTSTRAP_SERVERS="localhost:9092"

# Telegram Bot (get token from @BotFather)
TELEGRAM_BOT_TOKEN=8757887933:AAFNieHm2LcM3wJnRipOcFKHWxi49t7aKBc
BOT_DEMO_MODE=true
ADMIN_CHAT_IDS=
