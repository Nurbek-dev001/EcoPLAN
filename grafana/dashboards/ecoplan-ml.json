{
  "dashboard": {
    "id": null,
    "title": "EcoPlan ML Metrics",
    "tags": ["ml", "ecoplan"],
    "timezone": "Asia/Almaty",
    "schemaVersion": 36,
    "panels": [
      {
        "id": 1,
        "title": "Anomaly Detection Rate",
        "type": "timeseries",
        "targets": [
          {
            "expr": "rate(anomaly_detected_total[5m])",
            "legendFormat": "Anomalies/min"
          }
        ],
        "gridPos": {"h": 8, "w": 12, "x": 0, "y": 0}
      },
      {
        "id": 2,
        "title": "Pricing Recommendations",
        "type": "stat",
        "targets": [
          {
            "expr": "pricing_recommendations_total",
            "legendFormat": "Recommendations"
          }
        ],
        "gridPos": {"h": 8, "w": 12, "x": 12, "y": 0}
      },
      {
        "id": 3,
        "title": "Prophet Forecast Accuracy",
        "type": "timeseries",
        "targets": [
          {
            "expr": "prophet_mae",
            "legendFormat": "MAE"
          }
        ],
        "gridPos": {"h": 8, "w": 12, "x": 0, "y": 8}
      },
      {
        "id": 4,
        "title": "Route Optimizer Usage",
        "type": "bargauge",
        "targets": [
          {
            "expr": "route_optimizer_runs_total",
            "legendFormat": "Runs"
          }
        ],
        "gridPos": {"h": 8, "w": 12, "x": 12, "y": 8}
      }
    ]
  }
}
